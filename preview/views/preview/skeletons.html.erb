<%# Every skeleton sits beside the real thing it stands in for, so a difference in
    size — a line that's taller than the text it replaces, a card that's shorter —
    shows at a glance. %>
<% pair = "display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 1.5rem; align-items: start;" %>

<section>
  <h2>skeleton do |s| — blocking out your own layout</h2>
  <div style="<%= pair %>">
    <%= card do %>
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 9999px; background: #c7d2fe; flex-shrink: 0;"></div>
        <div style="flex: 1; min-width: 0;">
          <div style="font-weight: 600;">Ada Lovelace</div>
          <div>Engineer · London</div>
        </div>
      </div>
      <p style="margin: 0.75rem 0 0;">Wrote the first published algorithm for a machine, and saw it could reach beyond arithmetic.</p>
    <% end %>

    <%= card do %>
      <%= skeleton label: "Loading candidate" do |s| %>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <%= s.circle size: "3rem" %>
          <div style="flex: 1; min-width: 0;">
            <div style="font-weight: 600;"><%= s.text width: "60%" %></div>
            <%= s.text width: "40%" %>
          </div>
        </div>
        <p style="margin: 0.75rem 0 0;"><%= s.text lines: 2 %></p>
      <% end %>
    <% end %>
  </div>
</section>

<section>
  <h2>skeleton_text and skeleton_button — beside what they stand in for</h2>
  <div style="<%= pair %>">
    <div id="text_pairs">
      <p style="margin: 0;">One line of body text.</p>
      <p style="margin: 0;"><%= skeleton_text width: "45%" %></p>
      <p style="margin: 1rem 0 0; font-size: 1.5rem; font-weight: 600;">A larger heading</p>
      <p style="margin: 0; font-size: 1.5rem;"><%= skeleton_text width: "60%" %></p>
    </div>
    <div id="button_pairs" style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
      <%= tag.button "Small", type: "button", class: button_classes(:default, size: :small) %>
      <%= skeleton_button size: :small %>
      <%= tag.button "Default", type: "button", class: button_classes %>
      <%= skeleton_button %>
      <%= tag.button "Large", type: "button", class: button_classes(:default, size: :large) %>
      <%= skeleton_button size: :large %>
    </div>
  </div>
</section>

<section>
  <h2>page_header skeleton: true</h2>
  <div style="<%= pair %>">
    <div>
      <%= page_header title: "Deploy keys", description: "Keys that can pull from this repository." do %>
        <%= tag.button "Add key", type: "button", class: button_classes(:primary) %>
      <% end %>
    </div>
    <div>
      <%= page_header skeleton: true %>
    </div>
  </div>
</section>

<section>
  <h2>detail_list skeleton: true</h2>
  <div style="<%= pair %>">
    <%= detail_list do |list|
          list.item "Name", "Ada Lovelace"
          list.item "Role", "Engineer"
          list.item "Joined", "10 December 1815"
          list.item "Location", "London"
        end %>
    <%= detail_list skeleton: true do |list|
          list.item "Name"
          list.item "Role"
          list.item "Joined"
          list.item "Location"
        end %>
  </div>
</section>

<section>
  <h2>card skeleton: true</h2>
  <div style="<%= pair %>">
    <%= card title: "Members" do %>
      Ada, Grace and Katherine can see everything in this workspace, invite others, and
      manage its billing.
    <% end %>
    <%= card title: "Members", skeleton: true %>
  </div>
</section>
