<section>
  <h2>local_time_tag — relative, keeping itself current</h2>
  <%= table_tag [ "Rendered for", "format: :relative", "compact: true" ],
        [
          [ "10 seconds ago", @now - 10.seconds ],
          [ "5 minutes ago", @now - 5.minutes ],
          [ "3 hours ago", @now - 3.hours ],
          [ "1 day ago", @now - 1.day ],
          [ "3 days ago", @now - 3.days ],
          [ "40 days ago", @now - 40.days ],
          [ "In 2 hours", @now + 2.hours ],
          [ "In 400 days", @now + 400.days ]
        ].map { |label, at|
          [ label, local_time_tag(at, format: :relative), local_time_tag(at, format: :relative, compact: true) ]
        },
        widths: [ "30%", "40%", "30%" ] %>
</section>

<section>
  <h2>local_time_tag — absolute, in the viewer's zone</h2>
  <%= table_tag [ "format:", "Rendered" ],
        %i[short medium long full date time].map { |format| [ tag.code(":#{format}"), local_time_tag(@now, format: format) ] },
        widths: [ "30%", "70%" ] %>
</section>

<section>
  <h2>tooltip</h2>
  <p>
    Every page declares a
    <%= tooltip "canonical URL", text: "The address search engines treat as the original when the same page is reachable at several." %>
    in its head.
  </p>
  <div style="display: flex; gap: 0.5rem; justify-content: space-between; flex-wrap: wrap;">
    <%= tooltip text: "Shown below, flipping above when there's no room.", placement: :bottom do %>
      <button type="button" class="<%= button_classes %>">placement: :bottom</button>
    <% end %>
    <%= tooltip text: "Clamped so it never runs off the edge of the screen, however long the hint happens to get." do %>
      <button type="button" class="<%= button_classes %>">Near the right edge</button>
    <% end %>
  </div>
</section>

<section>
  <h2>menu</h2>
  <div style="display: flex; gap: 0.75rem; align-items: center; justify-content: space-between;">
    <%= menu "Options", align: :start do |menu| %>
      <% menu.link "Go to toasts", "/toasts" %>
      <% menu.link "Go to dialogs", "/dialogs" %>
    <% end %>
    <%= menu do |menu| %>
      <% menu.button "Send a toast", "/toasts/stream", params: { tone: "good", message: "Sent from a menu." } %>
      <% menu.divider %>
      <% menu.button "Delete", "/toasts/stream", tone: :danger,
           params: { tone: "bad", message: "Deleted (not really)." },
           form: { data: { turbo_confirm: "Delete this thing?", turbo_confirm_accept: "Delete",
                           turbo_confirm_variant: "danger" } } %>
    <% end %>
  </div>
</section>

<section>
  <h2>tabs — panels in the page, remembered with an id</h2>
  <%= tabs id: "preview_tabs" do |tabs| %>
    <% tabs.tab "Body" %>
    <% tabs.tab "Headers" %>
    <% tabs.tab "Preview", disabled: "HTML only" %>
    <% tabs.tab "Timing" %>
    <% tabs.panel do %>
      <pre style="margin: 0;">{ "ok": true }</pre>
    <% end %>
    <% tabs.panel do %>
      <%= detail_list do |list|
            list.item "Content-Type", "application/json"
            list.item "Cache-Control", "no-store"
          end %>
    <% end %>
    <% tabs.panel do %>
      Took 42ms.
    <% end %>
  <% end %>
</section>

<section>
  <h2>tabs — links to separate pages</h2>
  <%= tabs do |tabs| %>
    <% tabs.tab "Elements", href: "/elements", active: true %>
    <% tabs.tab "Toasts", href: "/toasts" %>
    <% tabs.tab "Archived", disabled: true %>
  <% end %>
</section>

<section>
  <h2>copy_button</h2>
  <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
    <code id="install_command">bundle add unmagic-components</code>
    <%= copy_button from: "install_command" %>
    <%= copy_button "deploy-key-preview-0000", class: button_classes(:default, size: :small) do %>Copy key<% end %>
  </div>
</section>

<section>
  <h2>autogrow_text_area and uuid_field</h2>
  <%= form_with url: "/elements", method: :get, builder: Unmagic::Components::FormBuilder, id: "grow_form" do |form| %>
    <%= form.field :message, "Message", as: :autogrow_text_area, rows: 2,
          placeholder: "Type a few lines, then keep going past ten rems…",
          style: "width: 100%; max-height: 10rem; box-sizing: border-box; padding: 0.5rem; font: inherit; border: 1px solid var(--unmagic-border-strong, #d4d4d4); border-radius: 0.375rem;" %>
    <%= form.uuid_field :id %>
    <button type="reset" class="<%= button_classes %>">Reset the form</button>
  <% end %>
</section>
