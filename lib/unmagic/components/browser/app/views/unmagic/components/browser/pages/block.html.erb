<% content_for :title, @block.name %>
<% content_for :breadcrumbs do %>
  <%= render "crumb", label: "Blocks", path: blocks_path %>
  <%= render "crumb", label: @block.name %>
<% end %>

<header class="mb-8">
  <p class="mb-3 text-xs font-medium text-neutral-500"><%= @block.category %></p>
  <h1 class="text-3xl font-semibold tracking-tight"><%= @block.name %></h1>
  <p class="mt-3 text-base text-neutral-600 dark:text-neutral-400"><%= @block.description %></p>
</header>

<browser-block-preview class="block">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <div class="flex gap-1 rounded-lg border border-neutral-200 p-1 dark:border-neutral-800" role="group" aria-label="Preview size">
        <% [
          [ "Desktop", "100%", "M3 4h18v13H3z M8 21h8 M12 17v4" ],
          [ "Tablet", "768px", "M5 2h14v20H5z M11 18h2" ],
          [ "Phone", "390px", "M7 2h10v20H7z M11 18h2" ]
        ].each_with_index do |(label, width, icon), index| %>
          <button type="button" class="BrowserPreviewControl" data-preview-width="<%= width %>" aria-label="<%= label %>" title="<%= label %>" aria-pressed="<%= index.zero? %>">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icon %>"/></svg>
          </button>
        <% end %>
      </div>
      <div class="flex gap-1 rounded-lg border border-neutral-200 p-1 dark:border-neutral-800" role="group" aria-label="Preview theme">
        <button type="button" class="BrowserPreviewControl" data-preview-theme="light" aria-pressed="true">Light</button>
        <button type="button" class="BrowserPreviewControl" data-preview-theme="dark" aria-pressed="false">Dark</button>
      </div>
      <button type="button" class="BrowserPreviewControl" data-preview-reload aria-label="Reload preview" title="Reload preview">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7V2m0 5h-5 M20 7a9 9 0 1 0 1 8"/></svg>
      </button>
    </div>
    <%= link_to "Open preview ↗", block_preview_path(@block.slug, preview_theme: "light"), target: "_blank", rel: "noopener", data: { preview_open: true }, class: button_classes(:default, size: :small) %>
  </div>
  <%= tabs id: "block_#{@block.slug}" do |tabs| %>
    <% tabs.tab "Preview" %>
    <% tabs.tab "Code" %>
    <% tabs.panel do %>
      <div class="overflow-x-auto rounded-xl border border-neutral-200 bg-neutral-100 p-2 sm:p-4 dark:border-neutral-800 dark:bg-neutral-900">
        <iframe src="<%= block_preview_path(@block.slug, preview_theme: "light") %>" title="<%= @block.name %> preview" data-preview-frame class="mx-auto block h-[760px] w-full border-0 bg-white shadow-sm"></iframe>
      </div>
      <p class="mt-2 text-xs text-neutral-500" data-preview-status aria-live="polite">Desktop · Light</p>
    <% end %>
    <% tabs.panel do %>
      <p class="mb-4 text-sm text-neutral-500">Copy this into a Rails view with unmagic-components and Tailwind installed. Sample data is included; replace it with your own records.</p>
      <%= render "code", id: "block_#{@block.slug}_source", source: block_source(@block) %>
    <% end %>
  <% end %>
</browser-block-preview>

<div class="mt-8">
  <h2 class="text-sm font-semibold">Built with</h2>
  <div class="mt-3 flex flex-wrap gap-2">
    <% @block.components.each do |slug| %>
      <%= link_to Unmagic::Components::Browser::Catalog.find(slug).name, component_path(slug), class: "rounded-md border border-neutral-200 px-3 py-1.5 text-xs hover:bg-neutral-100 dark:border-neutral-800 dark:hover:bg-neutral-800" %>
    <% end %>
  </div>
</div>
