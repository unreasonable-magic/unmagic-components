<div id="tool_call_states" class="mx-auto flex max-w-2xl flex-col gap-4">
  <% { queued: "night market", running: "night market", waiting: "which lantern?", done: "night market", failed: "example.com/pricing" }.each do |state, summary| %>
    <%= ai_chat_tool_call name: "render_scene", state: state, id: "state_#{state}", icon: :image, timeline: false do |tool| %>
      <% tool.summary summary %>
      <% tool.timing started_at: @now - 72, duration: 3.1 %>
      <% tool.failures 2 %>
      <% tool.progress "Frame 12 of 40" %>
      <% tool.asked({ scene: "night-market", frames: 40 }) %>
      <% tool.answered({ rendered: 38, errors: [ { frame: 7, error: "missing texture" }, { frame: 23, error: "missing texture" } ] }) %>
      <% tool.made { link_to "View the #{state} render", "#state_#{state}", class: "underline" } %>
    <% end %>
  <% end %>
</div>
