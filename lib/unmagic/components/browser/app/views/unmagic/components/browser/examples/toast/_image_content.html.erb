<% illustration = <<~SVG
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 320">
    <defs><linearGradient id="sky" x2="0" y2="1"><stop stop-color="#99c8df"/><stop offset="1" stop-color="#f8ddae"/></linearGradient></defs>
    <path fill="url(#sky)" d="M0 0h640v320H0z"/>
    <circle cx="482" cy="83" r="37" fill="#fff2cf"/>
    <path d="M0 230 150 102l132 128 91-83 175 173H0Z" fill="#668d91"/>
    <path d="M0 270 163 176l130 91 132-90 215 112v31H0Z" fill="#356f75"/>
    <path d="M0 280q160-38 310 4t330-7v43H0Z" fill="#224f59"/>
  </svg>
SVG
image_src = "data:image/svg+xml,#{ERB::Util.url_encode(illustration).tr('+', '%20')}"
%>
<div class="grid gap-2.5">
  <div>
    <div class="font-semibold">Your image is ready</div>
    <p class="mt-0.5 text-xs opacity-75">The landscape preview has finished rendering.</p>
  </div>
  <%= tag.img src: image_src, alt: "Illustrated mountain landscape at sunset",
        class: "aspect-[2/1] w-full rounded-md object-cover" %>
  <div class="flex gap-2">
    <%= tag.a "Download image", href: image_src, download: "landscape.svg",
          class: button_classes(:primary, size: :small) %>
    <%= tag.button "Dismiss", type: "button", class: button_classes(:default, size: :small),
          data: { unmagic_toast_dismiss: "" } %>
  </div>
</div>
