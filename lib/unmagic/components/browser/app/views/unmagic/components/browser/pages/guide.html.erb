<% content_for :title, @guide.name %>
<% content_for :breadcrumbs do %>
  <%= render "crumb", label: "Guides", path: root_path %>
  <%= render "crumb", label: @guide.name %>
<% end %>

<article class="max-w-3xl">
  <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-neutral-500"><%= @guide.category %></p>
  <h1 class="text-3xl font-semibold tracking-tight"><%= @guide.name %></h1>
  <p class="mt-3 max-w-2xl text-lg leading-8 text-neutral-600 dark:text-neutral-400"><%= @guide.description %></p>

  <%= render guide_partial(@guide) %>

  <% components = @guide.components.filter_map { |slug| Unmagic::Components::Browser::Catalog.find(slug) } %>
  <% if components.any? %>
    <h2 class="mt-12 text-lg font-semibold">See it working</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      <% components.each do |component| %>
        <li><%= link_to component.name, component_path(component.slug), class: button_classes %></li>
      <% end %>
    </ul>
  <% end %>
</article>
