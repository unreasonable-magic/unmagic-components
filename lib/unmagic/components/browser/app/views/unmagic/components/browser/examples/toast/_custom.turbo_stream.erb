<%= turbo_stream.toast(tone: :neutral, position: :bottom_start, duration: 0, width: :long, icon: false) do |toast| %>
  <% toast.body do %>
    <div class="space-y-3">
      <div class="flex items-center gap-2">
        <%= badge "New", tone: :accent %>
        <strong>A little more room to create</strong>
      </div>
      <p>Shared workspaces now include project notes. Keep decisions and next steps together.</p>
      <%= link_to "Explore the components", root_path, class: button_classes(size: :small), data: { unmagic_toast_dismiss: "" } %>
    </div>
  <% end %>
<% end %>
