<%= accordion exclusive: true, id: "billing_faq" do |accordion| %>
  <% accordion.item "When am I charged?", open: true do %>
    On the first of the month, for the month ahead.
  <% end %>
  <% accordion.item "Can I change plans?" do %>
    Any time. The difference is prorated.
  <% end %>
  <% accordion.item "What happens to my renders if I cancel?" do %>
    They stay yours; you can download them for ninety days.
  <% end %>
<% end %>
