<% content_for :breadcrumbs do %>
  <%= render "crumb", label: "Guides", path: root_path %>
  <%= render "crumb", label: "Overview" %>
<% end %>

<section class="max-w-3xl">
  <h1 class="text-4xl font-semibold tracking-tight">
    unmagic-components <span class="text-neutral-400 dark:text-neutral-500">for Rails</span>
  </h1>
  <p class="mt-5 text-lg leading-8 text-neutral-600 dark:text-neutral-400">
    Server-rendered UI components for Rails views, in the spirit of <code class="text-base">form_for</code>:
    describe the columns, the fields or the tabs, and get the chrome. Styled with Tailwind CSS v4, with
    behaviour from plain custom elements and no Stimulus.
  </p>
  <div class="mt-7 flex flex-wrap gap-2">
    <%= link_to "Installation", installation_path, class: button_classes(:primary) %>
    <%= link_to "Browse the components", components_path, class: button_classes %>
  </div>
</section>

<hr class="my-14 border-t border-dashed border-neutral-200 dark:border-neutral-800">

<% Unmagic::Components::Browser::GuideCatalog.grouped.each do |category, guides| %>
  <section id="category_<%= category.parameterize %>" class="mb-12 scroll-mt-20">
    <h2 class="mb-5 text-xl font-semibold"><%= category %></h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <% guides.each do |guide| %>
        <%= link_to guide_path(guide.slug), class: "block rounded-xl border border-neutral-200 p-5 hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600" do %>
          <h3 class="font-semibold"><%= guide.name %></h3>
          <p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400"><%= guide.description %></p>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
