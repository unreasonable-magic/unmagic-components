<div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
  <span>Close with <%= kbd "Esc" %></span>
  <span>Search with <%= kbd :mod, "K" %></span>
  <span>Command palette <%= kbd hotkey: "mod+shift+p" %></span>
  <span>Go to inbox <%= kbd "G", "I", sequence: true %></span>
  <span>Move <%= kbd :up %> <%= kbd :down %> and <%= kbd :enter %> to open</span>
</div>
