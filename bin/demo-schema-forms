#!/usr/bin/env ruby
# frozen_string_literal: true

# Visible, replayable demo. Start bin/dev first; screenshots go under tmp/.
require "bundler/setup"
require "fileutils"
require "unmagic/browser"

$stdout.sync = true
base = ENV.fetch("BROWSER_URL", "http://localhost:5701")
out = File.expand_path("../tmp/schema-forms-demo", __dir__)
FileUtils.mkdir_p(out)
driver = Unmagic::Browser::Driver::Local.new(headless: ENV["HEADLESS"] == "1", slow_mo: 20)
browser = Unmagic::Browser.new(driver: driver)
browser.open("#{base}/components/forms#forms_schema") do |session|
  session.wait_for(selector: "#schema_demo_form")
  session.emulate(viewport: { width: 1280, height: 1000 })
  session.evaluate("() => document.querySelector('#forms_schema').scrollIntoView()")
  raise "Default missing" unless session.value("#schema_demo_name") == "Ada"
  raise "Decimal step rejected" unless session.evaluate("() => document.querySelector('#schema_demo_rate').checkValidity()")
  File.binwrite("#{out}/defaults.png", session.screenshot)

  session.find("#schema_demo_name").fill_in("Al")
  session.find("#schema_demo_enabled").click
  session.find('#schema_demo_form button[type="submit"]').click
  session.wait_for(text: "Please correct the fields above")
  raise "Field error missing" unless session.has_selector?('#schema_demo_name[aria-invalid="true"]')
  raise "False became the default" if session.evaluate("() => document.querySelector('#schema_demo_enabled').checked")
  session.evaluate("() => document.querySelector('#forms_schema').scrollIntoView()")
  File.binwrite("#{out}/validation.png", session.screenshot)
  puts "Invalid submission: field error shown, unchecked boolean preserved"

  session.find("#schema_demo_name").fill_in("Alice")
  session.find("#schema_demo_rate").fill_in("12.75")
  session.find('#schema_demo_form button[type="submit"]').click
  session.wait_for(text: "Valid settings")
  raise "Typed output missing" unless session.evaluate(<<~JS)
    () => {
      const text = document.querySelector('#forms_schema').textContent;
      return text.includes('"rate": 12.75') && text.includes('"enabled": false');
    }
  JS
  session.evaluate("() => document.querySelector('#forms_schema').scrollIntoView()")
  File.binwrite("#{out}/valid.png", session.screenshot)
  puts "Corrected submission: number and boolean values validated"

  %w[light dark].each do |theme|
    [ 1280, 390 ].each do |width|
      session.emulate(viewport: { width: width, height: 1000 })
      session.visit("#{base}/components/forms?theme=#{theme}#forms_schema")
      session.wait_for(selector: "#schema_demo_form")
      session.evaluate("() => document.querySelector('#forms_schema').scrollIntoView()")
      File.binwrite("#{out}/#{theme}-#{width}.png", session.screenshot)
      raise "Schema form overflows at #{width}" if session.evaluate(<<~JS)
        () => [...document.querySelectorAll('#schema_demo_form, #schema_demo_form *')]
          .some(e => e.getBoundingClientRect().right > innerWidth)
      JS
    end
  end
  puts "Light/dark desktop/mobile layouts passed"
end
puts "Screenshots: #{out}"
