#!/usr/bin/env ruby

# Worktree management adapted from hoops. Keep compatible with system Ruby
# for editor hooks; dependency installation runs through mise when available.

require "fileutils"
require "json"
require "shellwords"
require "socket"
require_relative "support/git"

APP_ROOT = File.realpath(File.expand_path("..", __dir__))

# Stripped from ARGV before subcommand dispatch; only teardown and cleanup consult it.
DRY_RUN = ARGV.delete("--dry-run") || ARGV.delete("-n")

VANITY_APP = "unmagic-components".freeze

def usage
  puts <<~USAGE
    Usage: bin/git-worktree <subcommand>

      checkout BRANCH|URL|#PR        put a branch, GitHub branch/PR URL, or PR number in a set-up worktree
      setup                          prepare this linked worktree (idempotent)
      teardown PATH [PATH...]        drop a worktree's resources, then remove it
      teardown --keep PATH           drop resources only, leave the worktree
      teardown --prune [--dry-run]   drop resources for every worktree that's already gone
      list                           every checkout: what can go, what can't and why, ports
      cleanup                        list the worktrees that can go
      cleanup --delete [--dry-run]   tear down the ones it listed, with their branches
      cleanup --delete --force       ...and the merged ones still locked or in use
  USAGE
end

def system!(*args)
  system(*args, exception: true)
end

# A linked worktree's top-level .git is a file (a gitdir pointer), not a directory.
def linked_worktree?(path)
  File.file?(File.join(path, ".git"))
end

def worktree_slug(path)
  Dev::Git.name(path).downcase.gsub(/[^a-z0-9]+/, "_").gsub(/\A_+|_+\z/, "")
end

def vanity_name(path)
  "#{VANITY_APP}--#{Dev::Git.name(path).downcase.gsub(/[^a-z0-9]+/, "-").gsub(/\A-+|-+\z/, "")}"
end

def localroast?
  system("command -v localroast >/dev/null 2>&1")
end

# ------------------------------------------------------------------- setup

def free_port?(port)
  TCPServer.new("127.0.0.1", port).close
  true
rescue Errno::EADDRINUSE, Errno::EACCES
  false
end

# Ports already written into sibling worktrees' .env files, so two worktrees set
# up back to back don't grab the same not-yet-bound port.
def claimed_ports
  %x(git worktree list --porcelain).each_line.with_object([]) do |line, ports|
    next unless line.start_with?("worktree ")

    dir = line.delete_prefix("worktree ").strip
    env = File.join(dir, ".env")
    next if dir == APP_ROOT || !File.file?(env)

    File.foreach(env) do |setting|
      ports << Regexp.last_match(1).to_i if setting =~ /\APORT=(\d+)/
    end
  end
rescue StandardError
  []
end

def pick_port(from, taken)
  port = from
  port += 1 while taken.include?(port) || !free_port?(port)
  port
end

# Point the vanity hostname at this worktree's port. --force so re-running after
# a port change repoints the name instead of failing. A no-op without localroast
# installed: the browser remains accessible through localhost.
def map_vanity_host(name, port)
  return unless localroast?

  system("localroast add #{name} #{port} --force > /dev/null 2>&1")
end

# .env is per-worktree — it holds this one's browser port and URL.
# Supacode copies ignored files into a new worktree (see
# copyIgnoredOnWorktreeCreate in supacode.json), so a copy naming a *different*
# worktree can arrive holding somebody else's port. The generated header names
# the worktree it was written for, which is how an inherited one is spotted.
def env_written_for?(slug, dir = ".")
  env = File.join(dir, ".env")
  File.file?(env) && File.foreach(env).first.to_s.include?(%(for the "#{slug}" git worktree))
end

def env_port
  File.foreach(".env") { |setting| return Regexp.last_match(1).to_i if setting =~ /\APORT=(\d+)/ }
  nil
end

def run_setup
  unless linked_worktree?(APP_ROOT)
    puts "This is the main checkout — run bundle install, then bin/dev (port 5701)."
    return
  end

  slug = worktree_slug(APP_ROOT)
  puts "== Preparing the \"#{slug}\" git worktree =="
  runner = system("command -v mise >/dev/null 2>&1") ? [ "mise", "exec", "--" ] : []
  system(*(runner + [ "bundle", "check" ])) || system!(*(runner + [ "bundle", "install" ]))

  host = vanity_name(APP_ROOT)
  if env_written_for?(slug) && env_port
    web_port = env_port
    puts "Keeping existing .env (port #{web_port})"
  else
    if File.file?(".env") && !File.read(".env").start_with?("# Generated by bin/git-worktree setup")
      abort "Existing .env wasn't generated by bin/git-worktree; move it aside before setup."
    end
    web_port = pick_port(5702, claimed_ports)
    File.write(".env", <<~ENV)
      # Generated by bin/git-worktree setup for the "#{slug}" git worktree.
      PORT=#{web_port}
      APP_URL=http://localhost:#{web_port}
    ENV
  end
  map_vanity_host(host, web_port)
  puts "Browser → http://localhost:#{web_port}"
  puts "Vanity URL → https://#{host}.localhost" if localroast?
  system!(*(runner + [ "bundle", "exec", "rake", "browser:css" ]))
  puts "== Worktree ready — start it with: bin/dev =="
end

# ---------------------------------------------------------------- checkout

# Recognised without the "checkout" subcommand, since neither reads as a
# mistyped one: a GitHub branch or pull request URL, or a pull request number
# (#361, or a plain 361 — bash takes an unquoted #361 for a comment).
GITHUB_REF = %r{\A(?:https?://)?(?:www\.)?github\.com/([^/]+)/([^/]+)/(tree|pull)/([^?#]+)}i
PULL_REQUEST_NUMBER = /\A#?(\d+)\z/

def checkout_ref?(ref)
  ref.match?(GITHUB_REF) || ref.match?(PULL_REQUEST_NUMBER)
end

# What a ref names: the local branch to check out, the ref on origin to fetch
# it from, and whether the branch tracks origin.
def checkout_target(ref)
  if (match = ref.match(GITHUB_REF))
    owner, repo, kind, rest = match.captures
    if kind.casecmp?("pull")
      number = rest[/\A\d+/]
      abort "No pull request number in #{ref}" if number.nil?

      pull_request_target("https://github.com/#{owner}/#{repo}/pull/#{number}")
    else
      branch_target(branch_in_tree_path(rest.chomp("/").gsub(/%(\h\h)/) { Regexp.last_match(1).hex.chr }))
    end
  elsif (match = ref.match(PULL_REQUEST_NUMBER))
    pull_request_target(match[1])
  else
    branch_target(ref.delete_prefix("origin/"))
  end
end

def branch_target(branch)
  { branch: branch, source: "refs/heads/#{branch}", track: true }
end

# A fork's branch isn't on origin, so it comes from the refs/pull/N/head GitHub
# keeps for every pull request, as a pr-N branch with no upstream to push to.
def pull_request_target(pull_request)
  abort "Checking out a pull request needs the GitHub CLI (gh)." unless system("command -v gh >/dev/null 2>&1")

  json = %x(gh pr view #{pull_request.shellescape} --json number,headRefName,isCrossRepository)
  abort "Couldn't find pull request #{pull_request}." unless $?.success?

  info = JSON.parse(json)
  if info["isCrossRepository"]
    { branch: "pr-#{info["number"]}", source: "refs/pull/#{info["number"]}/head", track: false }
  else
    branch_target(info["headRefName"])
  end
end

# A tree URL doesn't say where the branch name ends and a directory begins —
# tree/fix/login/app/models could be branch "fix/login" or "fix" — so take the
# longest prefix origin has a branch for.
def branch_in_tree_path(path)
  return path unless path.include?("/")

  heads = %x(git ls-remote --heads origin).lines.map { |line| line.split("\t").last.strip.delete_prefix("refs/heads/") }
  parts = path.split("/")
  parts.size.downto(1).map { |count| parts.first(count).join("/") }.find { |candidate| heads.include?(candidate) } || path
end

# Brings an existing checkout up to origin only when nothing could be lost: no
# changes to tracked files, and no commits origin doesn't have.
def fast_forward_worktree(path, start)
  git = "git -C #{path.shellescape}"
  if !%x(#{git} status --porcelain --untracked-files=no).empty?
    puts "   left as it is — it has uncommitted changes"
  elsif system("#{git} merge --ff-only --quiet #{start.shellescape}", out: File::NULL, err: File::NULL)
    puts "   up to date with origin"
  else
    puts "   left as it is — it has commits origin doesn't"
  end
end

# Setup comes from the checked-out branch, which may predate bin/git-worktree
# and have only the bin/git-worktree-setup it replaced.
def set_up_worktree(path)
  succeeded =
    if File.executable?(File.join(path, "bin/git-worktree"))
      system("bin/git-worktree", "setup", chdir: path)
    elsif File.executable?(File.join(path, "bin/git-worktree-setup"))
      system("bin/git-worktree-setup", chdir: path)
    end
  puts "\nSetup didn't finish — run bin/git-worktree setup in #{path}" unless succeeded
end

def run_checkout(ref)
  abort "Usage: bin/git-worktree checkout BRANCH | GITHUB-URL | #PR" if ref.nil?

  target = checkout_target(ref)
  branch = target[:branch]

  puts "== Fetching #{branch} from origin =="
  if target[:track]
    start = "origin/#{branch}" if system("git", "fetch", "--quiet", "origin", "+#{target[:source]}:refs/remotes/origin/#{branch}")
  elsif system("git", "fetch", "--quiet", "origin", target[:source])
    start = %x(git rev-parse FETCH_HEAD).strip
  end

  local = system("git", "show-ref", "--verify", "--quiet", "refs/heads/#{branch}")
  abort "Couldn't fetch #{branch} from origin, and there's no local branch by that name." unless start || local
  puts "   couldn't fetch it — using the local branch" unless start

  existing = worktree_entries.find { |entry| entry["branch"] == "refs/heads/#{branch}" }
  if existing
    path = existing["worktree"]
    abort "#{branch} is checked out at #{path}, which is gone — bin/git-worktree teardown --prune clears it." unless File.directory?(path)

    puts "\n== #{branch} is already checked out at #{display_path(path)} =="
    fast_forward_worktree(path, start) if start && path != main_checkout
  else
    path = File.join(main_checkout, ".claude", "worktrees", branch.tr("/", "-"))
    abort "#{display_path(path)} already exists and isn't #{branch}'s worktree." if File.exist?(path)

    puts "\n== Adding worktree #{display_path(path)} =="
    if local
      system!("git", "worktree", "add", "--quiet", path, branch)
      fast_forward_worktree(path, start) if start
    else
      system!("git", "worktree", "add", "--quiet", target[:track] ? "--track" : "--no-track", "-b", branch, path, start)
    end
  end

  # An .env copied in from another checkout would share that checkout's ports.
  set_up_worktree(path) unless path == main_checkout || env_written_for?(worktree_slug(path), path)

  env = File.join(path, ".env")
  url = File.read(env)[/^APP_URL=(\S+)/, 1] if File.file?(env)
  puts "\n== #{branch} is in #{display_path(path)} =="
  puts "   #{url}" if url
  puts "   cd #{path.shellescape} && bin/dev"
end

# ---------------------------------------------------------------- teardown

def run(cmd)
  if DRY_RUN
    puts "   would run: #{cmd}"
  else
    system!(cmd)
  end
end

def remove_vanity_host(name)
  return unless localroast?

  puts "   remove vanity host #{name}.localhost"
  run("localroast remove #{name.shellescape} >/dev/null 2>&1")
end

# Every linked worktree's directory, skipping the main checkout (always the
# first entry `git worktree list` prints) — its resources use the canonical
# unsuffixed names, so its slug must never protect (or match) anything. Keyed
# off the listing, not APP_ROOT, so teardown works from inside a worktree too.
def linked_worktree_dirs
  dirs = %x(git worktree list --porcelain).each_line.with_object([]) do |line, found|
    found << line.delete_prefix("worktree ").strip if line.start_with?("worktree ")
  end
  dirs.drop(1)
end

def live_slugs
  linked_worktree_dirs.map { |dir| worktree_slug(dir) }
end

def live_vanity_names
  linked_worktree_dirs.map { |dir| vanity_name(dir) }
end

# Vanity hosts whose worktree is gone. localroast keeps its mappings in a hosts
# file of "<name> <port>" lines, so any "unmagic-components--*" entry no surviving worktree
# answers to has outlived what it pointed at. The main checkout's bare "unmagic-components"
# doesn't match the prefix, so it's never swept.
def prune_vanity_hosts(live)
  hosts = File.expand_path("~/.config/localroast/hosts")
  return unless localroast? && File.file?(hosts)

  File.foreach(hosts) do |line|
    next unless line =~ /\A(#{Regexp.escape(VANITY_APP)}--\S+)\s/o

    name = Regexp.last_match(1)
    remove_vanity_host(name) unless live.include?(name)
  end
end

def run_teardown(argv)
  prune = argv.delete("--prune")
  keep = argv.delete("--keep")
  if prune
    prune_vanity_hosts(live_vanity_names)
    run("git worktree prune")
  elsif argv.empty?
    abort "Usage: bin/git-worktree teardown PATH [PATH...] | --prune [--dry-run]"
  else
    argv.each do |path|
      full = File.exist?(path) ? File.realpath(path) : File.expand_path(path)
      abort "Not a registered linked worktree: #{path}" unless linked_worktree_dirs.include?(full)
      abort "Cannot remove the checkout running this command; use --keep." if full == APP_ROOT && !keep
      # Let Git reject dirty or locked worktrees before removing their resources.
      run("git worktree remove #{full.shellescape}") if File.exist?(full) && !keep
      remove_vanity_host(vanity_name(full))
    end
  end
end

# ----------------------------------------------------------------- cleanup

# Which linked worktrees are finished with, and why each of the others isn't.
#
# An agent cuts a worktree per task and nothing ends one's life but somebody
# remembering to, so they pile up — each holding a vanity hostname, and an open question about whether what's in it
# ever landed. This answers that question for all of them at once. It only
# reports; --delete then tears down exactly the ones it listed as deletable, and
# nothing else, because every worktree it keeps back is kept back for a reason it
# printed.
#
# Merged is a question about content, not commit ids. A worktree counts as merged
# when its HEAD is an ancestor of main, or `git cherry` finds every one of its
# patches already there, or merging it into main would leave main's tree exactly
# as it is — which catches a squash, and a rebase whose conflict resolution
# rewrote a patch. A merge that conflicts with main is unmerged: when in doubt,
# keep.
#
# Merged isn't enough to delete, because finished commits can sit under
# unfinished work: uncommitted or untracked files, a stash made on the branch
# (the stash list is shared by every checkout, so it outlives the directory), or
# someone still in it — a process whose working directory is inside, or a lock.
# Supacode and Claude Code lock the worktrees they cut; a lock naming a pid whose
# process has exited is stale and is cleared on the way out, and any other lock
# is left to its owner.
#
# --force goes past that second half — a lock, a process inside — and never the
# first. Someone still in a worktree is a judgement the person running cleanup
# can overrule: it stops the dev server and removes the hostname as teardown does,
# and leaves anything else (a terminal, an agent) running in a directory that's
# gone, which is what forcing means. Work that isn't on main is not a judgement,
# so no flag deletes it — and nothing deletes the checkout cleanup runs from.

def main_checkout
  @main_checkout ||= File.expand_path("..", File.expand_path(%x(git rev-parse --git-common-dir).strip))
end

def dev_server_pid(path)
  pidfile = File.join(path, "tmp/pids/server.pid")
  return unless File.file?(pidfile)

  pid = File.read(pidfile).strip
  pid if pid.match?(/\A\d+\z/) && system("kill -0 #{pid} 2>/dev/null")
end

# A server orphaned by a killed terminal would otherwise hold its port,  after the directory is gone.
def stop_server(path)
  pid = dev_server_pid(path)
  return unless pid

  puts "   stopping dev server (pid #{pid})"
  run("kill #{pid}")
end

# origin/main when there's a remote, fetched first: a worktree merged an hour ago
# by another checkout's push is only merged as far as the last fetch knows.
# Without one, whatever the main checkout has checked out.
def cleanup_base
  if system("git", "remote", "get-url", "origin", out: File::NULL, err: File::NULL)
    unless system("git", "fetch", "--quiet", "origin", "main")
      puts "(couldn't fetch origin — measuring against the last fetched origin/main)"
    end
    "origin/main"
  else
    %x(git -C #{main_checkout.shellescape} rev-parse --abbrev-ref HEAD).strip
  end
end

# `git worktree list --porcelain`, one hash per worktree: "worktree", "HEAD",
# "branch", and "locked" or "prunable" with their reasons. The main checkout
# always comes first.
def worktree_entries
  %x(git worktree list --porcelain).split("\n\n").map do |block|
    entry = {}
    block.each_line do |line|
      key, value = line.chomp.split(" ", 2)
      entry[key] = value || true
    end
    entry
  end
end

# Every process's working directory, from a single lsof: [pid, command, directory].
def process_directories
  @process_directories ||= begin
    processes = []
    pid = command = nil
    %x(lsof -d cwd -Fpcn 2>/dev/null).each_line do |line|
      value = line[1..-1].chomp
      case line[0]
      when "p"
        pid = value.to_i
      when "c"
        command = value
      when "n"
        processes << [ pid, command, value ]
      end
    end
    processes
  end
end

def process_alive?(pid)
  Process.kill(0, pid)
  true
rescue Errno::ESRCH
  false
rescue Errno::EPERM
  true
end

def pluralize(count, singular, plural = singular + "s")
  "#{count} #{count == 1 ? singular : plural}"
end

def display_path(path)
  if path.start_with?(main_checkout + "/")
    path.sub(main_checkout + "/", "")
  else
    path.sub(Dir.home, "~")
  end
end

# How many of HEAD's commits aren't on base — zero when it's merged by any of the
# three measures.
def commits_not_on(base, git)
  if system("#{git} merge-base --is-ancestor HEAD #{base.shellescape}", err: File::NULL)
    0
  else
    patches = %x(#{git} cherry #{base.shellescape} HEAD)
    abort "Cannot compare worktree with #{base}; refusing cleanup." unless $?.success?
    unpicked = patches.lines.count { |line| line.start_with?("+") }
    if unpicked.zero?
      0
    else
      merged = %x(#{git} merge-tree --write-tree #{base.shellescape} HEAD 2>/dev/null).lines.first.to_s.strip
      if $?.success? && merged == %x(#{git} rev-parse #{"#{base}^{tree}".shellescape}).strip
        0
      else
        unpicked
      end
    end
  end
end

# Everything cleanup knows about one worktree. :work lists what would be lost by
# deleting it, :use who would be pulled out from under — either keeps it.
def survey(entry, base)
  path = entry["worktree"]
  branch = entry["branch"].delete_prefix("refs/heads/") if entry["branch"]
  survey = { path: path, branch: branch, work: [], use: [], gone: false, locked: false, stale_lock: false, running_cleanup: false }

  git = "git -C #{path.shellescape}"
  if entry["prunable"] || !File.directory?(path)
    survey[:gone] = true
  elsif !system("#{git} rev-parse --verify --quiet HEAD", out: File::NULL, err: File::NULL)
    # Its .git pointer names a gitdir that isn't there — typically the main checkout was moved or
    # renamed. Every question below would fail and read as "clean and merged", so keep it instead.
    survey[:head] = "git can't read this worktree — `git worktree repair` from the main checkout may fix it"
    survey[:work] << "state unknown"
  else
    survey[:head] = %x(#{git} log -1 --format="%h %cr — %s").strip

    uncommitted = %x(#{git} status --porcelain).lines.size
    survey[:work] << pluralize(uncommitted, "uncommitted file") if uncommitted > 0

    unmerged = commits_not_on(base, git)
    survey[:work] << "#{pluralize(unmerged, "commit")} not on #{base}" if unmerged > 0

    if File.realpath(path) == File.realpath(APP_ROOT)
      survey[:running_cleanup] = true
      survey[:use] << "this is the checkout you're running this from"
    else
      # Claude Code titles its process with its version number, which says nothing on its own.
      names = process_directories.select { |_, _, directory| directory == path || directory.start_with?(path + "/") }
        .map { |_, command, _| command.match?(/\A\d+(\.\d+)+\z/) ? "claude" : command }
      counted = names.uniq.map { |name| names.count(name) > 1 ? "#{name} ×#{names.count(name)}" : name }
      survey[:use] << "in use by #{counted.first(4).join(", ")}#{", …" if counted.size > 4}" if counted.any?
    end
  end

  if branch
    stashes = %x(git stash list --format=%gs).lines.count { |line| line.start_with?("On #{branch}:", "WIP on #{branch}:") }
    survey[:work] << "#{pluralize(stashes, "stash", "stashes")} made on its branch" if stashes > 0
  end

  if entry["locked"]
    survey[:locked] = true
    reason = entry["locked"] == true ? "(no reason given)" : entry["locked"]
    pid = reason[/\(pid (\d+)/, 1]
    # Supacode's lock reason is a JSON blob; its owner is the part worth reading.
    owner = reason[/"owner\\?"\s*:\s*\\?"([^"\\]+)/, 1]
    if owner
      survey[:use] << "locked by #{owner}"
    elsif pid.nil?
      survey[:use] << "locked: #{reason}"
    elsif process_alive?(pid.to_i)
      survey[:use] << "locked by `#{%x(ps -o command= -p #{pid}).strip[0, 40]}` (pid #{pid})"
    else
      survey[:stale_lock] = true
    end
  end

  survey
end

def sort_surveys(surveys)
  {
    deletable: surveys.select { |survey| survey[:work].empty? && survey[:use].empty? },
    in_use: surveys.select { |survey| survey[:work].empty? && survey[:use].any? },
    unfinished: surveys.select { |survey| survey[:work].any? }
  }
end

# What list adds about any checkout, the main one included: the port its .env
# claims, whether its dev server is up, and how far main has moved on without it.
def checkout_facts(path, base)
  env = File.join(path, ".env")
  port = File.read(env)[/^PORT=(\d+)/, 1] if File.file?(env)
  behind = %x(git -C #{path.shellescape} rev-list --count HEAD..#{base.shellescape} 2>/dev/null).to_i

  facts = []
  if port
    facts << "port #{port}"
  elsif linked_worktree?(path)
    facts << "not set up"
  end
  facts << "dev server running" if dev_server_pid(path)
  facts << "#{behind} behind #{base}" if behind > 0
  facts.join(" · ")
end

def print_main_checkout(entry, base)
  path = entry["worktree"]
  git = "git -C #{path.shellescape}"
  branch = entry["branch"].delete_prefix("refs/heads/") if entry["branch"]
  uncommitted = %x(#{git} status --porcelain).lines.size
  facts = checkout_facts(path, base)

  puts "\nMain checkout:"
  puts "  #{display_path(path)}#{"  [#{branch}]" if branch}"
  puts "      #{%x(#{git} log -1 --format="%h %cr — %s").strip}"
  puts "      #{facts}" unless facts.empty?
  puts "      #{pluralize(uncommitted, "uncommitted file")}" if uncommitted > 0
end

# With a base, each worktree's checkout_facts too — list wants them, cleanup doesn't.
def print_surveys(heading, surveys, base = nil)
  return if surveys.empty?

  puts "\n#{heading} (#{surveys.size}):"
  surveys.each do |survey|
    branch = survey[:branch] unless survey[:branch].nil? || survey[:branch].end_with?(File.basename(survey[:path]))
    puts "  #{display_path(survey[:path])}#{"  [#{branch}]" if branch}"
    puts "      #{survey[:gone] ? "directory already gone" : survey[:head]}"
    if base && !survey[:gone]
      facts = checkout_facts(survey[:path], base)
      puts "      #{facts}" unless facts.empty?
    end
    puts "      stale lock — its process has exited" if survey[:stale_lock]
    (survey[:work] + survey[:use]).each { |reason| puts "      #{reason}" }
  end
end

# The deleted worktree's branch goes too — with -D, because a rebased branch is
# merged by content but not by ancestry, which is all -d can see. That it's
# merged by content was settled above.
def delete_surveyed(surveys)
  # Without --force, only a stale lock gets this far.
  surveys.select { |survey| survey[:locked] }.each do |survey|
    run("git worktree unlock #{survey[:path].shellescape}")
  end
  # Before the branches: git won't delete a branch a vanished worktree still has checked out.
  run("git worktree prune") if surveys.any? { |survey| survey[:gone] }

  surveys.each do |survey|
    puts "\nTearing down the \"#{worktree_slug(survey[:path])}\" worktree (#{survey[:path]})"
    survey[:use].each { |reason| puts "   forcing past: #{reason}" }
    stop_server(survey[:path]) unless survey[:gone]
    remove_vanity_host(vanity_name(survey[:path]))
    run("git worktree remove --force #{survey[:path].shellescape}") unless survey[:gone]
    run("git branch -D #{survey[:branch].shellescape}") if survey[:branch]
  end
end

def run_cleanup(argv)
  delete = argv.delete("--delete")
  force = argv.delete("--force")
  base = cleanup_base
  groups = sort_surveys(worktree_entries.drop(1).map { |entry| survey(entry, base) })
  forceable = groups[:in_use].reject { |survey| survey[:running_cleanup] }
  doomed = force ? groups[:deletable] + forceable : groups[:deletable]
  kept = groups.values.flatten - doomed

  puts "Measured against #{base}."
  print_surveys("Can be deleted", groups[:deletable])
  print_surveys("Merged, but still in use — included by --force", forceable) if force

  puts
  puts "Nothing to delete." if doomed.empty?
  puts "#{pluralize(kept.size, "other worktree")} kept — `bin/git-worktree list` says why." if kept.any?
  if !force && forceable.any?
    puts "#{forceable.size} of them are merged but still in use; --force includes those."
  end

  if delete
    delete_surveyed(doomed)
  elsif doomed.any?
    puts "Delete #{doomed.size == 1 ? "it" : "them"} with: bin/git-worktree cleanup --delete#{" --force" if force}"
  end
end

# -------------------------------------------------------------------- list

# Every checkout at a glance — the main one, then each worktree sorted as cleanup
# sorts them, with the reasons it keeps them and what each is running. Reports
# only; cleanup is what deletes.
def run_list
  base = cleanup_base
  entries = worktree_entries
  groups = sort_surveys(entries.drop(1).map { |entry| survey(entry, base) })

  puts "#{pluralize(entries.size - 1, "worktree")}, measured against #{base}."
  print_main_checkout(entries.first, base)
  print_surveys("Can be deleted", groups[:deletable], base)
  print_surveys("Merged, but still in use", groups[:in_use], base)
  print_surveys("Has work that isn't on #{base}", groups[:unfinished], base)

  puts "\nDelete what can be deleted with: bin/git-worktree cleanup --delete" if groups[:deletable].any?
end

FileUtils.chdir APP_ROOT do
  command = ARGV.shift
  abort "--dry-run only supports teardown and cleanup" if DRY_RUN && !%w[teardown cleanup].include?(command)
  case command
  when "checkout"
    run_checkout(ARGV.shift)
  when "setup"
    run_setup
  when "teardown"
    run_teardown(ARGV)
  when "list"
    run_list
  when "cleanup"
    run_cleanup(ARGV)
  when nil, "help", "-h", "--help"
    usage
  else
    if checkout_ref?(command)
      run_checkout(command)
    else
      usage
      abort "\nUnknown subcommand: #{command}"
    end
  end
end
