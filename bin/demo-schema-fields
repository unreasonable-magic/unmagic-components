#!/usr/bin/env ruby
# frozen_string_literal: true

# Replay in visible Chrome: start bin/dev, then bundle exec ruby bin/demo-schema-fields.
require "bundler/setup"
require "fileutils"
require "unmagic/browser"

$stdout.sync = true
base = ENV.fetch("BROWSER_URL", "http://localhost:5701")
out = File.expand_path("../tmp/schema-fields-demo", __dir__)
FileUtils.mkdir_p(out)
driver = Unmagic::Browser::Driver::Local.new(headless: ENV["HEADLESS"] == "1", slow_mo: 20)
Unmagic::Browser.new(driver: driver).open("#{base}/components/forms") do |session|
  session.emulate(viewport: { width: 1280, height: 1000 }, reduced_motion: :reduce)
  session.wait_for(selector: "#schema_demo_form textarea")
  session.find('#schema_demo_form textarea').fill_in("First line\nSecond line")
  raise "Missing text input" unless session.evaluate("() => document.querySelector('#schema_demo_form input[name=\"schema_demo[name]\"]').type === 'text'")
  raise "Missing color input" unless session.evaluate("() => document.querySelector('#schema_demo_form input[name=\"schema_demo[accent]\"]').type === 'color'")
  session.find('#schema_demo_form input[name="schema_demo[name]"]').fill_in("x")
  session.find('#schema_demo_form button[type="submit"]').click
  session.wait_for(text: "Please correct the fields above")
  raise "Lost multiline draft" unless session.evaluate("() => document.querySelector('#schema_demo_form textarea').value === 'First line\\nSecond line'")
  session.evaluate("() => document.querySelector('#schema_demo_form').scrollIntoView({block: 'center'})")
  File.binwrite("#{out}/invalid.png", session.screenshot)
  session.find('#schema_demo_form input[name="schema_demo[name]"]').fill_in("Ada Lovelace")
  session.find('#schema_demo_form button[type="submit"]').click
  session.wait_for(text: "Valid settings")
  %w[light dark].each do |theme|
    [ 1280, 390 ].each do |width|
      session.emulate(viewport: { width: width, height: 1000 }, reduced_motion: :reduce)
      session.visit("#{base}/components/forms?theme=#{theme}")
      session.wait_for(selector: "#schema_demo_form textarea")
      session.evaluate("() => document.querySelector('#schema_demo_form').scrollIntoView({block: 'center'})")
      File.binwrite("#{out}/#{theme}-#{width}.png", session.screenshot)
      raise "Schema form overflows viewport" if session.evaluate(<<~JS)
        () => Array.from(document.querySelectorAll('#schema_demo_form, #schema_demo_form input:not([type="hidden"]), #schema_demo_form textarea, #schema_demo_form select')).some(el => {
          const rect = el.getBoundingClientRect(); return rect.left < 0 || rect.right > innerWidth;
        })
      JS
      if width == 390
        puts session.evaluate(<<~JS)
          () => JSON.stringify({pageWidth: document.documentElement.scrollWidth, viewport: innerWidth,
            overflowing: Array.from(document.querySelectorAll('main input, main select, main textarea')).filter(el => el.getBoundingClientRect().right > innerWidth).map(el => el.name)})
        JS
      end
    end
  end
end
puts "Passed text, textarea, color, invalid/valid submission, draft preservation, and responsive themes. Screenshots: #{out}"
