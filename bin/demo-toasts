#!/usr/bin/env ruby
# frozen_string_literal: true

# Replay in visible Chrome: BROWSER_URL=http://localhost:5799 bundle exec ruby bin/demo-toasts
# Start bin/dev first. HEADLESS=1 hides Chrome; RECORD=1 saves WebM recordings.
# THEMES=dark WIDTHS=390 can replay a focused subset.
require "bundler/setup"
require "fileutils"
require "unmagic/browser"

base = ENV.fetch("BROWSER_URL", "http://localhost:5701")
out = File.expand_path("../tmp/toast-demo", __dir__)
FileUtils.mkdir_p(out)
driver = Unmagic::Browser::Driver::Local.new(headless: ENV["HEADLESS"] == "1", slow_mo: 30)
browser = Unmagic::Browser.new(driver: driver)

browser.open("#{base}/components/toast") do |session|
  recorder = nil
  capture = ->(name) { File.binwrite("#{out}/#{name}.png", session.screenshot) }
  check = ->(script, message) { raise message unless session.evaluate("() => (#{script.strip.delete_suffix(";")})") }
  clear = lambda do
    session.evaluate("() => document.querySelectorAll('[data-unmagic-toast] .UnmagicToast__dismiss').forEach(button => button.click())")
    sleep 0.3
  end
  click = lambda do |example, index = 0|
    session.find("#toast_#{example} form:nth-of-type(#{index + 1}) button").click
    session.wait_for(selector: "[data-unmagic-toast][data-open]")
  end

  ENV.fetch("THEMES", "light dark").split.each do |theme|
    ENV.fetch("WIDTHS", "1280 390").split.map(&:to_i).each do |width|
      session.emulate(viewport: { width: width, height: 900, touch: width < 640, mobile: width < 640 }, reduced_motion: :reduce)
      session.visit("#{base}/components/toast?theme=#{theme}")
      # The driver wraps Puppeteer; use its recorder for a replay of the visible demo.
      recorder = session.instance_variable_get(:@page).screencast(path: "#{out}/#{theme}-#{width}.webm", fps: 12) if ENV["RECORD"] == "1"
      click.call("duration", 2)
      click.call("duration", 0)
      session.find("#toast_duration").hover
      capture.call("sticky-and-timed-#{theme}-#{width}")
      sleep 2.5
      check.call("document.querySelectorAll('[data-unmagic-toast]').length === 1 && document.querySelector('[data-unmagic-toast]').dataset.duration === '0'", "Sticky/timed policy failed")
      sleep 3
      check.call("!!document.querySelector('[data-unmagic-toast][data-duration=\"0\"]')", "Sticky toast expired")
      session.find("[data-unmagic-toast] .UnmagicToast__dismiss").press("Enter")
      sleep 0.3
      check.call("!document.querySelector('[data-unmagic-toast]')", "Keyboard dismissal failed")

      %w[content tones positions width actions leading custom boundaries].each do |example|
        count = { "tones" => 7, "positions" => 6, "width" => 3, "actions" => 2 }.fetch(example, 1)
        count.times do |index|
          click.call(example, index)
          sleep 0.2
          check.call(<<~JS, "Toast overflow in #{example} at #{width}px")
            [...document.querySelectorAll('[data-unmagic-toast]')].every(el => {
              const r = el.getBoundingClientRect();
              return r.width > 0 && r.left >= -1 && r.right <= innerWidth + 1 && el.scrollWidth <= el.clientWidth + 1;
            })
          JS
          if example == "positions"
            position = %w[top_start top top_end bottom_start bottom bottom_end][index]
            check.call(<<~JS, "Incorrect #{position} placement")
              (() => {
                const el = document.querySelector('[data-unmagic-toast]');
                const r = el.getBoundingClientRect();
                const vertical = #{position.start_with?("top")} ? Math.abs(r.top - 16) < 2 : Math.abs(innerHeight - r.bottom - 16) < 2;
                const horizontal = #{position.end_with?("start")} ? Math.abs(r.left - 16) < 2 :
                  #{position.end_with?("end")} ? Math.abs(innerWidth - r.right - 16) < 2 : Math.abs((r.left + r.right) / 2 - innerWidth / 2) < 2;
                return vertical && horizontal;
              })()
            JS
          end
          if example == "boundaries"
            check.call(<<~JS, "Scoped toast escaped its panel")
              (() => {
                const toast = document.querySelector('#toast_panel [data-unmagic-toast]').getBoundingClientRect();
                const panel = document.querySelector('#toast_panel').parentElement.getBoundingClientRect();
                return toast.left >= panel.left && toast.right <= panel.right && toast.top >= panel.top && toast.bottom <= panel.bottom;
              })()
            JS
          end
          capture.call("#{example}-#{index}-#{theme}-#{width}")
          if example == "actions"
            session.find("[data-unmagic-toast] .UnmagicToast__actions button").click
            sleep 0.3
            check.call("!document.querySelector('[data-unmagic-toast]')", "Action dismissal failed")
          end
          clear.call
        end
      end
      recorder&.stop
      recorder = nil
      puts "Passed #{theme} at #{width}px"
    end
  end

  session.emulate(viewport: { width: 1280, height: 900 }, reduced_motion: :no_preference)
  session.visit("#{base}/components/toast?theme=light")
  click.call("duration", 2)
  session.evaluate("window.Turbo.visit(document.querySelector('a[href*=\"/components/button\"]').href)")
  session.wait_for(selector: "#button_variants")
  sleep 1
  check.call("!!document.querySelector('[data-unmagic-toast][data-duration=\"0\"]')", "Sticky toast lost on Turbo visit")
  session.evaluate("window.Turbo.visit(document.querySelector('a[href*=\"/components/toast\"]').href)")
  session.wait_for(selector: "#toast_duration")
  check.call("document.querySelectorAll('[data-unmagic-toast]').length === 1", "Toast duplicated on Turbo return")
  session.evaluate(<<~JS)
    async () => {
      const original = document.querySelector('[data-unmagic-toast]');
      const morphed = new Promise((resolve, reject) => {
        const timer = setTimeout(() => reject(new Error('No Turbo morph')), 5000);
        document.addEventListener('turbo:morph', () => { clearTimeout(timer); resolve(); }, { once: true });
      });
      window.Turbo.renderStreamMessage('<turbo-stream action="refresh"></turbo-stream>');
      await morphed;
      if (original !== document.querySelector('[data-unmagic-toast]')) throw new Error('Toast lost on morph');
    }
  JS
  clear.call

  click.call("duration", 0)
  session.find("[data-unmagic-toast] .UnmagicToast__dismiss").evaluate("el => el.focus()")
  sleep 2.5
  check.call("!!document.querySelector('[data-unmagic-toast]')", "Focus did not pause the timer")
  session.find("#toast_duration form button").evaluate("el => el.focus()")
  sleep 2.5
  check.call("!document.querySelector('[data-unmagic-toast]')", "Timer did not resume after blur")

  click.call("duration", 0)
  session.find("[data-unmagic-toast]").hover
  sleep 2.5
  check.call("!!document.querySelector('[data-unmagic-toast]')", "Hover did not pause the timer")
  session.find("#toast_duration").hover
  sleep 1.5
  check.call("!document.querySelector('[data-unmagic-toast]')", "Timer did not resume")
  session.find('#toast_above_dialog [data-unmagic-dialog-open="toast_over_dialog"]').click
  session.wait_for(selector: "dialog[open]")
  session.find("dialog[open] form button").click
  session.wait_for(selector: "[data-unmagic-toast]")
  capture.call("above-dialog")
  sleep 5.5
  check.call("!document.querySelector('[data-unmagic-toast]')", "Dialog toast did not expire")
  session.press("Escape")
  puts "Passed Turbo navigation, hover pause/resume, and above-dialog regression checks"
ensure
  recorder&.stop
end
puts "Screenshots: #{out}"
