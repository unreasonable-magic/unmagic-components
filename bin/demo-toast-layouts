#!/usr/bin/env ruby
# frozen_string_literal: true

# Replay: BROWSER_URL=http://localhost:5799 RECORD=1 bundle exec ruby bin/demo-toast-layouts
require "bundler/setup"
require "fileutils"
require "unmagic/browser"

base = ENV.fetch("BROWSER_URL", "http://localhost:5701")
out = File.expand_path("../tmp/toast-layout-demo", __dir__)
FileUtils.mkdir_p(out)
browser = Unmagic::Browser.new(driver: Unmagic::Browser::Driver::Local.new(headless: false))
browser.open("#{base}/components/toast") do |session|
  recorder = nil
  %w[light dark].each do |theme|
    [ 1280, 390 ].each do |width|
      session.emulate(viewport: { width: width, height: 900, touch: width < 640 }, reduced_motion: :reduce)
      session.visit("#{base}/components/toast?theme=#{theme}#toast_actions")
      recorder = session.instance_variable_get(:@page).screencast(path: "#{out}/#{theme}-#{width}.webm", fps: 12) if ENV["RECORD"] == "1"
      2.times do |index|
        session.find("#toast_actions form:nth-of-type(#{index + 1}) button").click
      end
      session.wait_for(selector: '[data-unmagic-toast][data-layout="vertical"]')
      raise "Redundant close button" if session.evaluate("!!document.querySelector('[data-unmagic-toast] .UnmagicToast__dismiss')")
      geometry = session.evaluate(<<~JS)
        () => [...document.querySelectorAll('[data-unmagic-toast]')].map(toast => {
          const content = toast.querySelector('.UnmagicToast__content').getBoundingClientRect();
          const actions = toast.querySelector('.UnmagicToast__actions').getBoundingClientRect();
          const buttons = [...toast.querySelector('.UnmagicToast__actions').children].map(el => el.getBoundingClientRect());
          const rect = toast.getBoundingClientRect();
          const vertical = toast.dataset.layout === 'vertical' || innerWidth < 640;
          return {vertical,
            aligned: vertical ? Math.abs(actions.left - content.left) < 1 : actions.left >= content.right,
            below: !vertical || actions.top >= content.bottom,
            row: Math.abs(buttons[0].top - buttons[1].top) < 1,
            contained: rect.left >= 0 && rect.right <= innerWidth && toast.scrollWidth <= toast.clientWidth + 1};
        })
      JS
      raise "Bad layout: #{geometry.inspect}" unless geometry.size == 2 && geometry.all? { |g| g.values_at("aligned", "below", "row", "contained").all? }
      File.binwrite("#{out}/#{theme}-#{width}.png", session.screenshot)
      2.times do
        session.find("[data-unmagic-toast] .UnmagicToast__actions button").press("Enter")
        sleep 0.1
      end
      raise "Dismissal failed" if session.evaluate("!!document.querySelector('[data-unmagic-toast]')")
      recorder&.stop
      recorder = nil
      puts "Passed #{theme} #{width}px: alignment, button row, containment, dismissal"
    end
  end
ensure
  recorder&.stop
end
puts "Demo artifacts: #{out}"
