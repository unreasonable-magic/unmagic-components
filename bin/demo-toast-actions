#!/usr/bin/env ruby
# frozen_string_literal: true

# Visible toast-action review: BROWSER_URL=http://localhost:5799 RECORD=1 bundle exec ruby bin/demo-toast-actions
require "bundler/setup"
require "fileutils"
require "unmagic/browser"

base = ENV.fetch("BROWSER_URL", "http://localhost:5701")
out = File.expand_path("../tmp/toast-action-demo", __dir__)
FileUtils.mkdir_p(out)
browser = Unmagic::Browser.new(driver: Unmagic::Browser::Driver::Local.new(headless: false))
browser.open("#{base}/components/toast") do |session|
  recorder = nil
  session.emulate(viewport: { width: 1280, height: 900 }, reduced_motion: :reduce)
  recorder = session.instance_variable_get(:@page).screencast(path: "#{out}/actions.webm", fps: 12) if ENV["RECORD"] == "1"
  %w[light dark].each do |theme|
    session.visit("#{base}/components/toast?theme=#{theme}#toast_content")
    # Exercise the real stream response with each supported tone.
    session.evaluate(<<~JS)
      async () => {
        const form = document.querySelector('#toast_content form');
        for (const tone of ['good', 'warn', 'bad', 'info', 'neutral', 'accent', 'inverted']) {
          const body = new FormData(form);
          body.set('tone', tone);
          body.set('duration', '0');
          const response = await fetch(form.action, {method: 'POST', body, headers: {Accept: 'text/vnd.turbo-stream.html'}});
          if (!response.ok) throw new Error('Toast response failed: ' + response.status);
          window.Turbo.renderStreamMessage(await response.text());
        }
      }
    JS
    session.wait_for(selector: ".UnmagicToast--inverted[data-open]")
    matches = session.evaluate(<<~JS)
      () => [...document.querySelectorAll('[data-unmagic-toast]')].every(toast => {
        const button = toast.querySelector('.UnmagicToast__actions button');
        return getComputedStyle(button).color === getComputedStyle(toast).color;
      })
    JS
    raise "Action tone mismatch in #{theme}" unless matches
    File.binwrite("#{out}/#{theme}.png", session.screenshot)
    7.times do
      session.find("#toast_content h2").hover
      action = session.find("[data-unmagic-toast] .UnmagicToast__actions button")
      before = action.evaluate("el => getComputedStyle(el).backgroundColor")
      action.hover
      after = action.evaluate("el => getComputedStyle(el).backgroundColor")
      raise "Missing hover state" if before == after
      action.press("Enter")
      sleep 0.1
    end
    raise "Got it did not dismiss every toast" if session.evaluate("!!document.querySelector('[data-unmagic-toast]')")
    puts "Passed #{theme}: all seven tones, hover and keyboard dismissal"
  end
ensure
  recorder&.stop
end
puts "Demo artifacts: #{out}"
