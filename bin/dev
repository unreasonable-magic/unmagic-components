#!/usr/bin/env bash

# The component preview server — see config.ru.
#
# The styles are Tailwind source, so they're compiled first:
# preview/tailwind/application.css imports the gem's engine.css the way a host's
# build does, and scans preview/ for the utilities its pages use. Then they're
# recompiled whenever any of that changes. Tailwind's own --watch doesn't follow
# the @import out to engine.css, so this checks the files' contents once a second
# instead.
set -e
cd "$(dirname "$0")/.."

tailwind() {
  bundle exec tailwindcss -i preview/tailwind/application.css -o preview/builds/tailwind.css
}

checksum() {
  find app/assets/tailwind preview -type f \( -name "*.css" -o -name "*.erb" -o -name "*.rb" \) \
    -not -path "preview/builds/*" -print0 2>/dev/null | sort -z | xargs -0 cat | cksum
}

tailwind

(
  last=$(checksum)
  while sleep 1; do
    now=$(checksum)
    if [ "$now" != "$last" ]; then
      last=$now
      tailwind || true
    fi
  done
) &
watcher=$!
trap 'kill "$watcher" 2>/dev/null' EXIT

bundle exec rackup -s puma -p 5701 -o 0.0.0.0
