#!/usr/bin/env bash

# The component browser, run on its own — see config.ru.
#
# The browser's stylesheet is prebuilt Tailwind (rake browser:css), so it is
# compiled first and then recompiled whenever the gem's CSS or the browser's
# views, catalog or Tailwind source change. Tailwind's own --watch doesn't follow
# the @import out to engine.css, so this checks the files' contents once a second
# instead.
set -e
cd "$(dirname "$0")/.."

# Load only the browser port; .env is data, not shell code.
if [ -z "${PORT:-}" ] && [ -f .env ]; then
  PORT=$(sed -n 's/^PORT=\([0-9][0-9]*\)$/\1/p' .env | head -1)
fi
PORT=${PORT:-5701}

browser=lib/unmagic/components/browser

css() {
  bundle exec rake browser:css
}

checksum() {
  find app/assets/tailwind "$browser/app" "$browser/catalog" "$browser/tailwind" -type f \
    \( -name "*.css" -o -name "*.erb" -o -name "*.rb" \) -print0 2>/dev/null | sort -z | xargs -0 cat | cksum
}

css

(
  last=$(checksum)
  while sleep 1; do
    now=$(checksum)
    if [ "$now" != "$last" ]; then
      last=$now
      css || true
    fi
  done
) &
watcher=$!
trap 'kill "$watcher" 2>/dev/null' EXIT

bundle exec rackup -s puma -p "$PORT" -o 0.0.0.0
